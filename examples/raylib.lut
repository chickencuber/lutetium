extern C fn InitWindow(i32, i32, cstr);
extern C fn CloseWindow();
extern C fn WindowShouldClose() -> bool;
extern C fn BeginDrawing();
extern C fn EndDrawing();
extern C fn ClearBackground(u32);
extern C fn DrawRectangle(i32, i32, i32, i32, u32);
extern C fn SetTargetFPS(i32);
extern C fn GetScreenWidth() -> i32;
extern C fn GetScreenHeight() -> i32;

fn main() -> i32 {
    InitWindow(800, 600, "Hello from lutetium");
    let x = 100;
    let y = 100;
    let vx = 10;
    let vy = 10;
    let size = 200;
    let width = GetScreenWidth();
    let height = GetScreenHeight();
    SetTargetFPS(30);
    while !WindowShouldClose() {
        BeginDrawing();
        ClearBackground(0xff181818);
        DrawRectangle(x, y, size, size, 0xff0000ff);
        let nx = x+vx;
        let ny = y+vy;
        if (nx < 0 || nx + size > width) vx = -vx; else x = nx;
        if (ny < 0 || ny + size > height) vy = -vy; else y = ny;

        EndDrawing();
    }
    CloseWindow();
    return 0;
}
